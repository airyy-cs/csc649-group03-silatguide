# Copy this file to ".env" to override defaults. NO API KEYS are needed - everything runs locally.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Low temperature = consistent, fact-sticking answers
OLLAMA_TEMPERATURE=0.1
# Small context + short answers keep memory use modest (good for a 16 GB laptop)
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=220
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m
# Retrieval settings
TOP_K=3
SIMILARITY_THRESHOLD=0.25
